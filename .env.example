# CineMind Akinator — environment variables
# Copy to .env.local for local dev. In production, set these in
# Netlify: Site settings > Environment variables. Never commit real values.

# --- Core security (REQUIRED in production) ---
# HMAC secret for signing session tokens. App THROWS in production if unset.
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Bearer token guarding /api/cron/* endpoints. Set the same value in the
# Netlify scheduled functions' environment.
CRON_SECRET=

# --- Public site URL ---
# TWO variables exist for one idea, and setting only one leaves the other on its fallback:
#   NEXT_PUBLIC_BASE_URL — checkout success/cancel urls and every link inside an email
#   NEXT_PUBLIC_SITE_URL — canonical tags, hreflang, robots.txt, sitemap.xml, og:image
# Set BOTH to the same public origin in production. If SITE_URL is unset the sitemap and the
# canonical tags quietly fall back to https://cinemind.co.il; if BASE_URL is unset the checkout
# throws and every email link points at localhost.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase (backend: auth + Firestore) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Local Firebase emulator (dev only) ---
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- TMDB (movie data) ---
TMDB_API_KEY=

# --- OpenAI (LLM features) ---
OPENAI_API_KEY=
# Which OpenAI model the non-brain paths use. Unset falls back to the code's default.
OPENAI_MODEL=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- Telegram (ops alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CEO_CHAT_ID=

# --- PostHog (analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- The local taste model (Ollama) ---
# The brain engine writes its Hebrew reasons with a local model. Unset means the defaults below.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# --- Support and admin ---
# Printed on /purchase, /accessibility and the legal pages as the address people write to.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@cinemind.co.il
# Firebase uids allowed into /admin, comma separated. Empty means nobody.
ADMIN_UIDS=
# Renders the admin entry point at all. Leave false in production unless it is needed.
NEXT_PUBLIC_ENABLE_ADMIN=false

# --- Test and development switches (never set these in production) ---
# BRAIN_MOCK=1 answers the quiz from fixtures instead of TMDB, for tests.
BRAIN_MOCK=
# MOCK_GPT=1 skips the language model and returns a canned reason.
MOCK_GPT=
# DISABLE_RATE_LIMIT=true turns off the 60-requests-a-minute guard. Development only —
# the limiter is already disabled automatically when NODE_ENV is development.
DISABLE_RATE_LIMIT=
