# CineMind Akinator — environment variables
# Copy to .env.local for local dev. In production, set these in
# Netlify: Site settings > Environment variables. Never commit real values.

# --- Core security (REQUIRED in production) ---
# HMAC secret for signing session tokens. App THROWS in production if unset.
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Bearer token guarding /api/cron/* endpoints. Set the same value in the
# Netlify scheduled functions' environment.
CRON_SECRET=

# --- Public site URL ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Firebase (backend: auth + Firestore) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Local Firebase emulator (dev only) ---
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- TMDB (movie data) ---
TMDB_API_KEY=

# --- OpenAI (LLM features) ---
OPENAI_API_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- Telegram (ops alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CEO_CHAT_ID=

# --- PostHog (analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
